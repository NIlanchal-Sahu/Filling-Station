rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function myRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isAdmin() {
      return isSignedIn() && myRole() == "admin";
    }

    function isOwner() {
      return isSignedIn() && myRole() == "owner";
    }

    function isManager() {
      return isSignedIn() && myRole() == "manager";
    }

    function isOperator() {
      return isSignedIn() && myRole() == "operator";
    }

    /** Operational read access for manager, admin, and owner. */
    function isOpsReader() {
      return isManager() || isAdmin() || isOwner();
    }

    /** Operational write access — owner is read-only on pump data. */
    function isOpsWriter() {
      return isManager() || isAdmin();
    }

    function shiftData(shiftId) {
      return get(/databases/$(database)/documents/shifts/$(shiftId)).data;
    }

    function ownsShift(shiftId) {
      return isSignedIn() && shiftData(shiftId).operatorId == request.auth.uid;
    }

    /* Users — admin manages team; signed-in staff can read names for the shift roster. */
    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /fuelTypes/{id} {
      allow read: if isSignedIn();
      allow create, delete: if isOpsWriter();
      allow update: if isOpsWriter()
        || (isOperator()
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['currentStockLiters', 'lastDipCm', 'lastDipAt', 'currentRate', 'lastUpdatedAt']));
    }

    match /fuelTankDips/{id} {
      allow read: if isSignedIn();
      allow create, update: if isOpsWriter() || isOperator();
      allow delete: if isOpsWriter();
    }

    match /fuelReceipts/{id} {
      allow read: if isSignedIn();
      allow create, update: if isOpsWriter() || isOperator();
      allow delete: if isOpsWriter();
    }

    match /nozzles/{id} {
      allow read: if isSignedIn();
      allow write: if isOpsWriter();
    }

    /* Shifts */
    match /shifts/{shiftId} {
      allow read: if isOpsReader() || ownsShift(shiftId);
      allow create: if (isOpsWriter() || (isOperator() && request.resource.data.operatorId == request.auth.uid))
        && request.resource.data.status in ["open", "closed"];
      allow update, delete: if isOpsWriter() || (isOperator() && resource.data.operatorId == request.auth.uid);
    }

    match /shiftReadings/{id} {
      allow read: if isOpsReader() || (isOperator() && ownsShift(resource.data.shiftId));
      allow create: if isOpsWriter() || (isOperator() && ownsShift(request.resource.data.shiftId));
      allow update, delete: if isOpsWriter() || (isOperator() && ownsShift(resource.data.shiftId));
    }

    match /shiftReconciliations/{id} {
      allow read: if isOpsReader() || (isOperator() && resource.data.operatorId == request.auth.uid);
      allow create: if isOpsWriter() || (isOperator() && request.resource.data.operatorId == request.auth.uid);
      allow update, delete: if isOpsWriter() || (isOperator() && resource.data.operatorId == request.auth.uid
        && resource.data.status == "pending");
    }

    match /creditCustomers/{id} {
      allow read: if isOpsReader();
      allow write: if isOpsWriter();
    }
    match /creditSales/{id} {
      allow read: if isOpsReader() || (isOperator() && ownsShift(resource.data.shiftId));
      allow create: if isOpsWriter() || (isOperator() && ownsShift(request.resource.data.shiftId)
        && request.resource.data.keys().hasAll(["customerId", "shiftId", "date", "amount"]));
      allow update, delete: if isOpsWriter();
    }
    match /creditPayments/{id} {
      allow read: if isOpsReader();
      allow write: if isOpsWriter();
    }

    match /ledgerEntries/{id} {
      allow read: if isOpsReader();
      allow write: if isOpsWriter();
    }

    match /lubricants/{id} {
      allow read: if isOpsReader();
      allow write: if isOpsWriter();
    }
    match /lubricantStockEntries/{id} {
      allow read: if isOpsReader();
      allow write: if isOpsWriter();
    }
    match /lubricantSales/{id} {
      allow read: if isOpsReader();
      allow write: if isOpsWriter();
    }

  }
}
