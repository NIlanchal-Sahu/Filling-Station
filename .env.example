# Copy to `.env` (Vite reads VITE_* at build time).
#
# Option A — local demo without Firebase (data in browser localStorage):
#   During `npm run dev`, leaving every `VITE_FIREBASE_*` line empty behaves as offline demo (no `.env` needed).
#   To make that explicit in any environment (or builds), use:
#     VITE_LOCAL_DEMO=true
# Option B — production-style Firebase app:
#   Fill the Firebase values from Firebase Console → Project settings → Your apps.
#   After filling `.env`: `npm run firebase:sync-project` (writes `.firebaserc` from VITE_FIREBASE_PROJECT_ID).

VITE_LOCAL_DEMO=

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# --- Optional: `npm run firebase:bootstrap` (Admin SDK; set GOOGLE_APPLICATION_CREDENTIALS to service account JSON path) ---
# SEED_MANAGER_EMAIL=
# SEED_MANAGER_PASSWORD=
# SEED_MANAGER_NAME=Site Manager
# SEED_OPERATOR_EMAIL=
# SEED_OPERATOR_PASSWORD=
# SEED_OPERATOR_NAME=Pump Operator
