# Copy to `.env` for local builds (Vite reads VITE_* at build time).
# On Vercel: Project → Settings → Environment Variables (same names).
# Vite inlines these at `npm run build`.
#
# Option A — demo without Firebase (data in browser localStorage):
#   Leave every `VITE_FIREBASE_*` line empty (works for `npm run dev` and Vercel).
#   Optional: VITE_LOCAL_DEMO=true
# Option B — production-style Firebase app:
#   Fill every Firebase value from Firebase Console → Project settings → Your apps.
#   After filling `.env`: `npm run firebase:sync-project` (writes `.firebaserc` from VITE_FIREBASE_PROJECT_ID).

VITE_LOCAL_DEMO=

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# --- Optional: `npm run firebase:bootstrap` (Admin SDK; set GOOGLE_APPLICATION_CREDENTIALS to service account JSON path) ---
# SEED_MANAGER_EMAIL=
# SEED_MANAGER_PASSWORD=
# SEED_MANAGER_NAME=Site Manager
# SEED_OPERATOR_EMAIL=
# SEED_OPERATOR_PASSWORD=
# SEED_OPERATOR_NAME=Pump Operator
