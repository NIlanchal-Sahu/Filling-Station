# Copy to `.env` for local builds (Vite reads VITE_* at build time).
# On Vercel: Project → Settings → Environment Variables (same names).
# Vite inlines these at `npm run build`.
#
# Option A — demo without Supabase (data in browser localStorage):
#   Leave both `VITE_SUPABASE_*` lines empty (works for `npm run dev` and Vercel).
#   Optional: VITE_LOCAL_DEMO=true
# Option B — Supabase:
#   Fill the URL and anon key from Supabase → Project Settings → API.
#   Do NOT put the service role key in a VITE_ variable (it would ship to the browser).

VITE_LOCAL_DEMO=

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Optional: `npm run supabase:bootstrap` (service role; never prefix with VITE_) ---
# SUPABASE_SERVICE_ROLE_KEY=
# SEED_ADMIN_EMAIL=
# SEED_ADMIN_PASSWORD=
# SEED_ADMIN_NAME=Admin
# SEED_OWNER_EMAIL=
# SEED_OWNER_PASSWORD=
# SEED_OWNER_NAME=Owner
# SEED_MANAGER_EMAIL=
# SEED_MANAGER_PASSWORD=
# SEED_MANAGER_NAME=Site Manager
# SEED_OPERATOR_EMAIL=
# SEED_OPERATOR_PASSWORD=
# SEED_OPERATOR_NAME=Pump Operator
